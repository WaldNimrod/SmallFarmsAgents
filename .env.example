# OrganicMarketAgent — local environment
#
# PostgreSQL runs via Docker (docker-compose.yml).
# Start DB: docker-compose up -d
# Stop DB:  docker-compose down
#
# Current dev DB (existing oma-g2-ev container — G2 data):
#   DATABASE_URL=postgresql://oma:t@localhost:55435/organic
#
# Fresh docker-compose DB (oma-postgres on port 5433):
#   DATABASE_URL=postgresql://oma:oma@localhost:5433/organic_market_agent

DATABASE_URL=postgresql://oma:t@localhost:55435/organic
RAW_FILES_ROOT=/Users/nimrod/Documents/SmallFarmsAgents/raw_files
LOG_LEVEL=INFO
ENVIRONMENT=local

# Email alerting (M6+)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_FROM=
EMAIL_TO=
EMAIL_PASSWORD=

# uPress FTPS upload (M7 — Go-Live)
# Transport: FTPS (FTP over TLS) on port 21. SSH/SFTP port 22 is blocked.
# Fill in from `.env.upress` (or merge into `.env`). The app loads `.env` then `.env.upress` (non-overriding) — see `organic_market_agent/utils/config.py`.
# See: _COMMUNICATION/TEAM_100/reports/2026-03-31_M7_WORK_PLAN_FOR_APPROVAL_TEAM100.md §6.6
UPRESS_SFTP_HOST=
UPRESS_SFTP_PORT=21
UPRESS_SFTP_USER=
UPRESS_SFTP_PASS=
# Public URL origin only (no path). upload_base in manifest = UPRESS_PUBLIC_BASE + "/" + UPRESS_UPLOAD_PATH
UPRESS_PUBLIC_BASE=https://www.nimrod.bio
UPRESS_UPLOAD_PATH=wp-content/uploads/market
# After FTPS, optional: GET public manifest and compare artifact_version (warns on CDN mismatch)
# UPRESS_VERIFY_PUBLIC_MANIFEST=1
# After FTPS, optional: POST WordPress ezCache purge (needs Application Password; may 403 from some networks)
# UPRESS_EZCACHE_PURGE_AFTER_UPLOAD=1

# WP REST API upload (WP007 — primary upload path via HTTPS port 443; replaces FTPS port 21)
# Required on waldhomeserver for daily cron. team_00 supplies the Application Password.
# Set UPRESS_FALLBACK_FTPS=1 only when you want to fall back to FTPS (e.g., non-blocked network, no WP creds).
UPRESS_WP_REST_BASE=https://www.nimrod.bio/wp-json
UPRESS_WP_APP_USER=
UPRESS_WP_APP_PASS=
# UPRESS_FALLBACK_FTPS=1
UPRESS_PAGE_SLUG=/SmallFarmsAgent
# Optional: WordPress Application Password for REST (page discovery) — can live in `.env.upress`
# UPRESS_WP_ADMIN_USER=
# UPRESS_WP_ADMIN_PASS=

# Playwright (M10.4 — mypips SPA headless browser)
# Set to false to show browser window during local debug sessions.
PLAYWRIGHT_HEADLESS=true
# Timeout in milliseconds for Playwright page.goto() and wait_for_selector().
PLAYWRIGHT_TIMEOUT_MS=30000
