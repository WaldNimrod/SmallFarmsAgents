# sfa.nimrod.bio environment template
# Copy to .env on uPress; chmod 600; never commit real .env

APP_ENV=production
APP_DEBUG=false

# MySQL (uPress site — accessed as localhost from PHP-FPM)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sfanms2u_SFAUserUiDB
DB_USER=sfanms2u_DbAdmin
DB_PASS=

# Ingest API HMAC shared secret — MUST match SFA_INGEST_HMAC_SECRET on waldhomeserver .env
INGEST_HMAC_SECRET=

# One-time bootstrap migration token (rotated/removed after first migrate run)
ADMIN_MIGRATE_TOKEN=

# Logging
LOG_LEVEL=info
