{
    "name": "smallfarms/sfa-delivery",
    "description": "SFA dedicated delivery tier (sfa.nimrod.bio) — Slim 4 + MySQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "ext-json": "*",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SFA\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SFA\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php migrations/migrate.php",
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
